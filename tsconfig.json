{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"strict": true,
		"alwaysStrict": true,
		"moduleDetection": "force",
		"outDir": "dist",
		"rootDir": "src",
		"allowSyntheticDefaultImports": true,
		"noUnusedLocals": true,
		"inlineSourceMap": true,
		"noImplicitAny": true
	}
}